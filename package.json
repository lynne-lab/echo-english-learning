{
  "name": "echo-listening",
  "productName": "Echo",
  "version": "0.6.0",
  "private": true,
  "description": "Echo - English listening & speaking practice desktop app",
  "author": "Echo",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "sidecar": ".venv/Scripts/python.exe -m sidecar.app.main --port 8765",
    "build:sidecar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-sidecar.ps1",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
